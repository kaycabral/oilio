# Supabase (Auth). Local values come from the local stack: `pnpm db:start` then
# `pnpm db:env` writes them here. Production values live only in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, NEVER expose. Only the Auth admin API (LGPD account deletion).
SUPABASE_SECRET_KEY=

# Postgres. The app connects as the `oilio_app` runtime role (DML only, no
# BYPASSRLS). Event store + product base share one database; the two vars stay
# separate on purpose (product is a sovereign bounded context).
OILIO_DATABASE_URL=
DATABASE_URL=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`; random, >= 32 bytes.
CRON_SECRET=

# Dark-launch feature flags (in-progress surfaces). Absent/empty = OFF, which is
# the intended PROD state: the route 404s, the nav item is hidden, the API 404s —
# clients never see work-in-progress. Set to `true` (or `1`) locally to develop
# and test the feature; the E2E suite forces them on. These are NEXT_PUBLIC_ and
# inlined at build time, so flipping in prod is a rebuild+redeploy, not a runtime
# toggle. Read via src/shared/flags.ts (isFeatureEnabled). Leave OFF in prod until
# the feature is done, tested, and its plan approves the flip.
# NEXT_PUBLIC_FF_FINANCE=
# NEXT_PUBLIC_FF_COPILOT=
# NEXT_PUBLIC_FF_NOTIFICATIONS=

# Stripe — Assinatura Oilio (SaaS billing, lojista → Oilio). Server-only secrets,
# NEVER expose. Prefer a restricted API key (rk_) over a secret key (sk_).
# Setup of the graduated Products/Prices is documented in docs/stripe-setup.md;
# the price ids below come from there (test-mode ids in .env.local, live in prod).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ADVANCED_MONTHLY=
STRIPE_PRICE_ADVANCED_ANNUAL=

# Sentry — error observability (client + server). The DSN is public (send-only),
# so it rides a NEXT_PUBLIC_ var, inlined at build time. Empty DSN → Sentry is a
# no-op. It only ships events in production (NODE_ENV=production); local dev with
# a DSN set stays silent. SENTRY_AUTH_TOKEN is a build-time secret (source-map
# upload for readable stacks) and lives only in CI, never here.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
