{
  "name": "@oilio/web",
  "version": "0.6.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/no-eslint-suppressions.mjs && next typegen && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "pnpm db:exec \"vitest run --config vitest.integration.config.ts\"",
    "test:integration:watch": "pnpm db:exec \"vitest --config vitest.integration.config.ts\"",
    "test:e2e": "pnpm db:exec \"playwright test\"",
    "test:e2e:smoke": "pnpm db:exec \"playwright test --grep @smoke\"",
    "test:e2e:critical": "pnpm db:exec \"playwright test --grep @critical\"",
    "db:exec": "npx -y firebase-tools emulators:exec --only firestore,auth --project scheduling-local --config ../firebase.json",
    "db:start": "npx -y firebase-tools emulators:start --project scheduling-local --config ../firebase.local.json",
    "db:stop": "pkill -f 'firebase-tools.*emulators:start|java.*firestore' || true",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "type-coverage": "type-coverage --at-least 99 --strict --ignore-catch",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@cbrl/design": "workspace:*",
    "@cbrl/env": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "effect": "catalog:",
    "firebase": "catalog:",
    "firebase-admin": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@cbrl/eslint-base": "workspace:*",
    "@cbrl/testing": "workspace:*",
    "@cbrl/tsconfig-base": "workspace:*",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-plugin-check-file": "^3.3.1",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
