{
  "name": "@oilio/web",
  "version": "0.6.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/no-eslint-suppressions.mjs && node scripts/no-legacy-catalog-symbols.mjs && next typegen && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "node ../../../scripts/oilio-events-it.mjs",
    "test:integration:pg": "vitest run --config vitest.pg-integration.config.ts",
    "test:integration:events:pg": "vitest run --config vitest.events-pg-integration.config.ts",
    "test:e2e": "node ../../../scripts/e2e-with-postgres.mjs",
    "test:e2e:smoke": "node ../../../scripts/e2e-with-postgres.mjs --grep @smoke",
    "test:e2e:critical": "node ../../../scripts/e2e-with-postgres.mjs --grep @critical",
    "test:e2e:catalog": "node ../../../scripts/e2e-with-postgres.mjs tests/e2e/catalog --workers=1",
    "test:e2e:identity": "node ../../../scripts/e2e-with-postgres.mjs tests/e2e/units tests/e2e/company tests/e2e/team tests/e2e/invites tests/e2e/company-booking-qr.spec.ts tests/e2e/onboarding/app-usable-without-setup.spec.ts tests/e2e/onboarding/profile-completion.spec.ts tests/e2e/onboarding/publish-self-booking-blocked.spec.ts --workers=1",
    "db:exec": "npx -y firebase-tools emulators:exec --only auth --project scheduling-local --config ../firebase.json",
    "db:start": "npx -y firebase-tools emulators:start --project scheduling-local --config ../firebase.local.json",
    "db:stop": "pkill -f 'firebase-tools.*emulators:start' || true",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "type-coverage": "type-coverage --at-least 99 --strict --ignore-catch",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@cbrl/db": "workspace:*",
    "@cbrl/design": "workspace:*",
    "@cbrl/env": "workspace:*",
    "@cbrl/product": "workspace:*",
    "@google-cloud/cloud-sql-connector": "catalog:",
    "@types/qrcode": "^1.5.6",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:",
    "firebase": "catalog:",
    "firebase-admin": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@cbrl/eslint-base": "workspace:*",
    "@cbrl/testing": "workspace:*",
    "@cbrl/tsconfig-base": "workspace:*",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-plugin-check-file": "^3.3.1",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
