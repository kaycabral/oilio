# Firebase Web SDK (browser + server). Firebase Console → Project settings → General → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin SA (optional, server-only — NEVER expose).
# `@scaffold/db` defaults to Application Default Credentials, which is what App Hosting
# runs and what `gcloud auth application-default login` provides locally. Only set the
# three vars below if you need to authenticate as a specific service account from a
# context where ADC is not available. The emulator suite ignores them.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
