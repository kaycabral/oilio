{
  "name": "oilio",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts *.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @oilio/web run test:e2e",
    "test:integration": "node scripts/product-it.mjs",
    "knip": "pnpm --filter @oilio/web exec knip --no-progress",
    "mutation": "pnpm --filter @oilio/web run mutation",
    "type-coverage": "pnpm -r --workspace-concurrency=Infinity --reporter-hide-prefix run type-coverage",
    "db:up": "docker compose -f docker/postgres.compose.yaml up -d --wait",
    "db:down": "docker compose -f docker/postgres.compose.yaml down -v",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "prepare": "node .husky/install.mjs"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "pnpm": {
    "overrides": {
      "vite": "^8.0.13"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "msw",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@cbrl/commitlint-config": "^0.1.0",
    "@cbrl/eslint-config": "^0.1.0",
    "@cbrl/prettier-config": "^0.1.0",
    "@commitlint/cli": "^19.8.1",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.5",
    "pg": "catalog:",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "type-coverage": "^2.29.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
