{
  "name": "oilio",
  "version": "0.6.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/no-eslint-suppressions.mjs && node scripts/no-legacy-catalog-symbols.mjs && next typegen && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "node scripts/product-it.mjs",
    "test:integration:events": "node scripts/oilio-events-it.mjs",
    "test:integration:product": "vitest run --config vitest.product-integration.config.ts",
    "test:integration:pg": "vitest run --config vitest.pg-integration.config.ts",
    "test:integration:events:pg": "vitest run --config vitest.events-pg-integration.config.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:e2e:smoke": "tsx scripts/e2e.ts --grep @smoke",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:e2e:critical": "tsx scripts/e2e.ts --grep @critical",
    "test:e2e:catalog": "tsx scripts/e2e.ts tests/e2e/catalog --workers=1",
    "test:e2e:identity": "tsx scripts/e2e.ts tests/e2e/units tests/e2e/company tests/e2e/team tests/e2e/invites tests/e2e/company-booking-qr.spec.ts tests/e2e/onboarding/app-usable-without-setup.spec.ts tests/e2e/onboarding/profile-completion.spec.ts tests/e2e/onboarding/publish-self-booking-blocked.spec.ts --workers=1",
    "db:start": "supabase start --workdir . -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor,postgrest && pnpm db:migrate:local",
    "db:stop": "supabase stop --workdir .",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.product.config.ts",
    "db:check": "drizzle-kit check && drizzle-kit check --config drizzle.product.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:local": "tsx scripts/migrate-local.ts",
    "db:env": "tsx scripts/local-env.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "stripe:sync-catalog": "tsx --env-file-if-exists=.env.local scripts/sync-stripe-catalog.ts",
    "knip": "knip --no-progress",
    "mutation": "stryker run",
    "type-coverage": "type-coverage --at-least 99 --strict --ignore-catch",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "prepare": "node .husky/install.mjs"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "pnpm": {
    "overrides": {
      "postcss-selector-parser@<6.1.5": "^6.1.6",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.9",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "qs@<6.16.1": "^6.16.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "msw",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@cbrl/br": "^0.2.0",
    "@cbrl/design": "^0.6.3",
    "@cbrl/env": "^0.1.1",
    "@cbrl/log": "^0.1.0",
    "@cbrl/next": "^0.2.0",
    "@cbrl/pg": "^0.3.0",
    "@cbrl/supabase": "^0.2.0",
    "@sentry/nextjs": "11.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "~0.45.4",
    "effect": "^4.1.5",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "23.2.0"
  },
  "devDependencies": {
    "@cbrl/commitlint-config": "^0.2.0",
    "@cbrl/eslint-config": "^0.3.0",
    "@cbrl/prettier-config": "^0.1.0",
    "@cbrl/testing": "^0.4.0",
    "@cbrl/tsconfig": "^0.1.1",
    "@commitlint/cli": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-check-file": "^3.3.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "supabase": "3.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "type-coverage": "^2.31.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.6",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
